# Cloudflare Pages edge-cache rules — addresses low cache hit ratio.
# Pages are mostly static SSG; Cloudflare caches them at the edge so
# repeat visitors and crawlers stop hitting the origin/edge function.

# Versioned Next.js static assets — immutable, cache hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public images and icons.
/*.svg
  Cache-Control: public, max-age=86400, s-maxage=86400
/*.png
  Cache-Control: public, max-age=86400, s-maxage=86400
/*.jpg
  Cache-Control: public, max-age=86400, s-maxage=86400
/*.ico
  Cache-Control: public, max-age=86400, s-maxage=86400

# Dynamic edge endpoints — cache at edge with revalidation.
/og
  Cache-Control: public, max-age=86400, s-maxage=86400
/sitemap.xml
  Cache-Control: public, max-age=600, s-maxage=600
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=3600

# HTML pages — long edge cache, short browser cache + revalidate.
# Detail pages are prerendered (●) and indexes are edge ƒ; both benefit
# from a generous s-maxage with stale-while-revalidate.
/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400
