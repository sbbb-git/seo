# Cloudflare Pages edge-cache rules.
# Versioned Next.js asset bundles — never change after build.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Prerendered country and city pages — these are SSG so we bypass the
# Next worker via _routes.json (which would otherwise hard-code
# `must-revalidate`) and serve them straight from Cloudflare Pages'
# static-asset layer with these headers attached. 10-minute edge cache
# + 24h stale-while-revalidate.
/en/countries/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
